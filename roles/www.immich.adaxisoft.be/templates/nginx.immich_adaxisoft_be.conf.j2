server {
	listen           80;
	listen           [::]:80;
	server_name      {{immich_adaxisoft_be_domain}};

	location /.well-known {
		root /var/www/html/;
		allow all;
	}

	location / {
		return 301 https://$server_name$request_uri;
	}
}

server {
	listen              443 ssl;
	listen              [::]:443 ssl;
	ssl_certificate     /etc/letsencrypt/live/{{immich_adaxisoft_be_domain}}/fullchain.pem;
	ssl_certificate_key /etc/letsencrypt/live/{{immich_adaxisoft_be_domain}}/privkey.pem;
	keepalive_timeout   70;

	server_name         {{immich_adaxisoft_be_domain}};
	root                {{immich_adaxisoft_be_home}};
	access_log          /var/log/nginx/{{immich_adaxisoft_be_domain}}.access.log	combined;
	error_log           /var/log/nginx/{{immich_adaxisoft_be_domain}}.error.log    error;

	# Immich uploads original photos/videos, which can be large.
	client_max_body_size 50000M;
	proxy_read_timeout    600s;
	proxy_send_timeout    600s;

	location / {
		proxy_pass http://{{immich_adaxisoft_be_upstream}};
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection 'upgrade';
		proxy_cache_bypass $http_upgrade;
	}
}
